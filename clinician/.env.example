# Supabase project (Settings -> API). Leave empty to run the dashboard on demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth0 sign-in (Google + email). Leave empty to use Supabase's own email/password + Google sign-in instead.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Name of the Auth0 Google connection (default google-oauth2)
VITE_AUTH0_GOOGLE_CONNECTION=

# Video consults (default https://meet.jit.si). Use a self-hosted Jitsi or Jitsi-as-a-Service for real patients.
VITE_VIDEO_BASE_URL=
