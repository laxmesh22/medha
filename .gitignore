# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Node / build output
node_modules/
hub/physiobuddy_hub/api/static/

# Models (downloaded with `python -m physiobuddy_hub fetch-models`; copy to Jetson manually)
hub/models/
*.onnx
*.engine

# Recordings and session data - contain patient/volunteer data, never commit
hub/data/
ml/data/
*.bag

# Raw downloaded assets (Rocketbox FBX/TGA, BodyParts3D OBJ) - regenerate with tools/
assets_src/

# Blender video intermediates (the final MP4 and stills are committed)
hardware/renders/frames/
hardware/renders/*.blend
hardware/renders/*.blend1
hardware/renders/test_*

# Vendor STEP models (third-party licences): fetch per hardware/cad/vendor/README.md
hardware/cad/vendor/*.step
hardware/cad/vendor/*.stp
hardware/cad/vendor/*.STEP
hardware/cad/vendor/*.STP

# Secrets
.env
*.env.local

# Strap firmware BLE test environment (hub venv stays in hub/.venv)
firmware/.venv/

# Claude <-> Cursor bridge traffic (tools/cursor_bridge)
tools/cursor_bridge/LIVE/
